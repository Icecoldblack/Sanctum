# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# Required. Base64 of 32 random bytes. Generate with:  openssl rand -base64 32
SANCTUM_ENCRYPTION_KEY=

# Gemini API key (https://aistudio.google.com/apikey). Without it, chat and SOS expand return 503.
GEMINI_API_KEY=

# Optional in dev (defaults point at docker-compose Postgres).
DATABASE_URL=jdbc:postgresql://localhost:5432/sanctum
DATABASE_USER=sanctum
DATABASE_PASSWORD=sanctum

# Frontend origin(s) allowed to call the API, comma-separated, no trailing slash.
# Optional in dev (defaults to http://localhost:5173); required in production.
# Example: https://sanctumpro.tech,https://sanctum.vercel.app
SANCTUM_ALLOWED_ORIGIN=

# Set automatically by most hosts (Render, Railway, Cloud Run). Defaults to 8080.
# PORT=8080
